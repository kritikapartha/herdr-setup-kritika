# Track only the files we own; Herdr writes or replaces everything else.
/*
!/.gitignore
!/keys.json
!/layouts/
/layouts/*
!/layouts/my-*.json
!/mods/
/mods/*
!/mods/my-*/
!/mods/review/
!/mods/work/
!/mods/repos/
!/mods/task/
!/mods/pr-changes/
!/mods/auto-changes/
!/mods/review-branch/
*.d.ts
jsconfig.json
!/README.md
!/extras/
